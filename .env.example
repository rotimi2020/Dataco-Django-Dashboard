# Local development environment.
# For PythonAnywhere production values, see PYTHONANYWHERE_DEPLOYMENT.md.
# Copy this file to .env and replace the placeholder with a newly generated key.
DJANGO_SECRET_KEY=replace-this-with-a-new-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0
